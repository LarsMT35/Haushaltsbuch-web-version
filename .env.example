# Kopieren nach .env und Werte setzen. Die .env gehört NICHT ins Git.
DB_PASSWORD=bitte-aendern
SECRET_KEY=bitte-langen-zufallswert-setzen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern
APP_PORT=8080

# --- Optional: lokale KI (Ollama) ------------------------------------------
# Leer lassen = aus. Dann bleibt die App komplett ohne KI nutzbar und die
# Funktion erscheint gar nicht erst in der Oberflaeche.
# Zeigt auf die EIGENE Instanz im eigenen Netz; es geht nichts an einen
# fremden Dienst. Uebertragen werden nur Gegenpartei, Verwendungszweck und
# Betrag - keine IBANs, keine Saldenstaende. Die KI schlaegt nur vor,
# zugeordnet wird erst nach Bestaetigung.
# OLLAMA_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=llama3.1
